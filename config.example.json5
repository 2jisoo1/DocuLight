// DocuLight Configuration File (JSON5 format)
// Copy this file to config.json5 and update with your settings
{
  // Root directory for documents (absolute path recommended)
  docsRoot: "/data/docs",

  // Data directory for user management
  // Stores users.json, groups.json, pending-registrations.json
  // Default: "./data"
  dataDir: "./data",

  // Email server configuration (optional, required for signup workflow)
  // email: {
  //   host: "smtp.example.com",
  //   port: 587,
  //   secure: false,
  //   auth: {
  //     user: "noreply@example.com",
  //     pass: "password"
  //   },
  //   from: "DocLight <noreply@example.com>"
  // },

  // Maximum upload file size in megabytes
  maxUploadMB: 1000,

  // Port number for the server
  port: 3000,

  // Base path for reverse proxy sub-path deployment (optional)
  // When deploying behind nginx with sub-path proxy (e.g., /develop/ → localhost:3000/),
  // set this to the sub-path prefix so static resources and URLs work correctly.
  // Must start with "/" and NOT end with "/" (e.g., "/develop", "/docs/v2")
  // Default: "" (no sub-path, direct access)
  // basePath: "/develop",

  // UI customization
  ui: {
    // Sidebar title (default: "DocuLight")
    title: "DocuLight",

    // Icon path (default: "./public/images/icon.png")
    // Use file path (relative to project root)
    // Server will serve it from public directory via web path
    icon: "./public/images/icon.png",

    // Maximum width for the markdown content area (default: "1024px")
    // Supports units: px, %, em, rem, vw, etc.
    maxWidth: "1024px",

    // Index file to auto-load on startup (optional)
    // Use relative path from docsRoot (e.g., "README.md", "guide/index.md")
    // Special value "CHATBOT": enables chatbot mode as the main page
    //   - ChatbotService will be initialized
    //   - / route redirects to /chatbot
    // If not specified or file doesn't exist, shows welcome screen
    indexFile: "README.md",


    // Custom API documentation file (optional)
    // Use relative path from project root (e.g., "./public/api-doc.md")
    // Defaults to ./public/api-doc.md
    apiIndexFile: "./public/api-doc.md",

    // Custom MCP documentation file (optional)
    // Use relative path from project root (e.g., "./public/mcp-doc.md")
    // Defaults to ./public/mcp-doc.md
    mcpIndexFile: "./public/mcp-doc.md"
  },

  // Files and directories to exclude (gitignore-compatible patterns)
  excludes: [
    "**/.git/",
    "**/.DS_Store",
    "**/node_modules/",
    "**/.idea/",
    "*.tmp",
    "*.log"
  ],

  // Log settings
  log: {
    dir: "./logs",           // Log directory
    level: "info",           // Log level: 'error' | 'warn' | 'info' | 'debug'
    maxDays: 30,             // Log retention period (days)
    history: true            // Enable log history (for future use)
  },

  // Security settings (optional)
  security: {
    // IP whitelist patterns (optional)
    // If not specified, all IPs are allowed
    allows: [
      "127.0.0.1",           // Exact IP
      "::1",                 // IPv6 localhost
      "10.0.1.*",            // Wildcard: 10.0.1.0-255
      "10.0.100-200.*",      // Range: 10.0.100.0-255 ~ 10.0.200.0-255
      "192.168.1.0/24"       // CIDR notation
    ]
  },

  // SSL/TLS configuration (optional)
  // If enabled, server runs on HTTPS
  // If disabled or not specified, server runs on HTTP
  ssl: {
    enabled: false,
    cert: "/path/to/cert.pem",
    key: "/path/to/key.pem",
    ca: "/path/to/ca.pem"  // Optional: CA certificate
  },

  // Hot-reload options (optional)
  // hotReload.allowPortSslAutoRestart: when true, watcher will attempt an automatic restart even if port or SSL config changed.
  // Default: false (recommended) — port/SSL changes often require external coordination (load-balancer, certificates).
  // Example:
  // hotReload: {
  //   allowPortSslAutoRestart: false
  // }

  // Authentication settings
  // Controls user login requirements for viewing documents
  // auth: {
  //   // Require login to view documents (default: false)
  //   requireReadLogin: false,
  //
  //   // Session timeout in milliseconds (default: 3600000 = 1 hour, min: 60000)
  //   sessionTimeout: 3600000,
  //
  //   // Allow new user signups (default: true)
  //   allowSignup: true,
  //
  //   // Restrict signups to specific email domains (empty = all domains allowed)
  //   allowedEmailDomains: [],
  //
  //   // Signup mode: "approval" (admin must approve) or "self" (instant registration)
  //   signupMode: "approval",
  //
  //   // Self-signup settings (only used when signupMode is "self")
  //   selfSignup: {
  //     defaultGroupName: "Viewer"  // Default group for self-registered users
  //   }
  // },

  // Admin Mode settings (optional)
  // Controls file management capabilities
  // Session timeout is managed via /admin settings page after initial setup
  // admin: {
  //   // Allow file uploads in admin mode (default: true)
  //   allowUpload: true,
  //
  //   // Allow file/folder deletion in admin mode (default: true)
  //   allowDelete: true,
  //
  //   // Maximum upload size in MB (default: same as maxUploadMB)
  //   maxUploadSize: 10,
  //
  //   // File extensions that can be edited in admin mode
  //   // (default: [".md", ".txt", ".json", ".json5", ".yaml", ".yml"])
  //   editableExtensions: [".md", ".txt", ".json", ".json5", ".yaml", ".yml"],
  //
  //   // Maximum file size for editing in bytes (default: 1048576 = 1MB)
  //   // Files larger than this cannot be opened in the editor
  //   maxEditableSize: 1048576
  // },

  // HTML Caching System
  cache: {
    // Enable/disable caching system
    // Set to false to use client-side rendering (old behavior)
    enabled: true,

    // Throttle for request-based scan (milliseconds)
    // Prevents excessive scans on concurrent user requests
    // Recommended values:
    //   - 200: Low traffic, fast updates
    //   - 500: Moderate traffic (default)
    //   - 1000: High traffic, reduce server load
    scanThrottle: 500,

    // Maximum memory cache size (MB)
    // LRU eviction when exceeded
    // Recommended: 100MB for ~200 files (35KB avg)
    maxMemorySize: 100,

    // Maximum disk cache size (MB)
    // Old caches deleted when exceeded
    maxDiskSize: 500,

    // Pre-render all files on server startup
    // false: lazy rendering (on first request) - faster startup
    // true: eager rendering (slower startup, faster first request)
    preRenderOnStartup: true,

    // Server-side Mermaid diagram rendering
    // Requires Puppeteer (heavyweight, slow first render)
    // false: send mermaid code to client (recommended, faster)
    // true: render SVG on server (complete, but slow)
    mermaidSSR: false,

    // Cache directory (relative to project root)
    // Will be created automatically if missing
    cacheDir: "./.cache",

    // HTML compression level
    // 0: none (faster, more disk space, recommended)
    // 1: gzip (slower, less disk space)
    compressionLevel: 0,

    // Auto-cleanup old cache files (days)
    // Files not accessed for this many days will be deleted
    // Set to 0 to disable cleanup
    cleanupAfterDays: 30
  },

  // Auto-Summary Configuration
  // Automatically generates .summary.md files for directories using LLM
  // Requires chatbot.llm (or summary.llm) to be configured
  // summary: {
  //   // Enable auto-summary (default: false)
  //   enabled: false,
  //
  //   // Maximum lines in generated summary (default: 200)
  //   maxLines: 200,
  //
  //   // Debounce time in ms after document changes (default: 30000 = 30s)
  //   // Summary generation starts after no changes for this duration
  //   debounceMs: 30000,
  //
  //   // Maximum concurrent summary generations (default: 1, max: 5)
  //   concurrency: 1,
  //
  //   // Additional directory patterns to exclude from summarization
  //   // Inherits from top-level excludes
  //   excludeDirs: [],
  //
  //   // Optional: dedicated LLM for summaries (if omitted, uses chatbot.llm)
  //   // llm: {
  //   //   type: "openai",
  //   //   endpoint: "https://api.openai.com/v1",
  //   //   apiKey: "your-api-key",
  //   //   model: "gpt-4o-mini",
  //   //   temperature: 0.3,
  //   //   maxTokens: 2048
  //   // }
  // },

  // RAG Chatbot Configuration
  // Enable AI-powered document Q&A chatbot
  // chatbot: {
  //   // LLM Configuration
  //   llm: {
  //     // Provider type: "openai" | "azure-openai" | "ollama"
  //     type: "azure-openai",
  //
  //     // API endpoint
  //     // - OpenAI: "https://api.openai.com/v1"
  //     // - Azure: "https://<resource>.openai.azure.com"
  //     // - Ollama: "http://localhost:11434"
  //     endpoint: "https://your-resource.openai.azure.com",
  //
  //     // API key (leave empty for Ollama)
  //     apiKey: "your-api-key-here",
  //
  //     // Model name
  //     model: "gpt-4o",
  //
  //     // Azure OpenAI specific: deployment name (required for azure-openai)
  //     deploymentName: "gpt-4o",
  //
  //     // Context window size in tokens
  //     contextLength: 128000,
  //
  //     // Generation temperature (0-2, default: 0.7)
  //     temperature: 0.7,
  //
  //     // Maximum output tokens (default: 4096)
  //     maxTokens: 4096
  //   },
  //
  //   // Embedding Configuration
  //   embedding: {
  //     // Provider type: "openai" | "azure-openai" | "ollama"
  //     type: "azure-openai",
  //
  //     // API endpoint
  //     endpoint: "https://your-resource.openai.azure.com",
  //
  //     // API key (leave empty for Ollama)
  //     apiKey: "your-api-key-here",
  //
  //     // Model name
  //     model: "text-embedding-3-small",
  //
  //     // Azure OpenAI specific: deployment name (required for azure-openai)
  //     deploymentName: "text-embedding-3-small"
  //   },
  //
  //   // RAG Settings (optional)
  //   rag: {
  //     // Document chunk size in characters (default: 1000)
  //     chunkSize: 1000,
  //
  //     // Overlap between chunks (default: 200)
  //     chunkOverlap: 200,
  //
  //     // Number of documents to retrieve (default: 20)
  //     retrievalCount: 20,
  //
  //     // Minimum similarity score for retrieved documents (default: 0.3)
  //     // Documents with similarity below this threshold are excluded from RAG
  //     // Range: 0.0 - 1.0 (higher = more strict filtering)
  //     // Recommended: 0.3 for general use, 0.5 for stricter relevance
  //     minSimilarityScore: 0.3,
  //
  //     // Vector Store Persistence Settings (HNSWLib)
  //     // Enables persistent storage of document embeddings
  //     persistence: {
  //       // Directory for vector store data (relative or absolute path)
  //       // Default: "./data/vector"
  //       dataDir: "./data/vector",
  //
  //       // Enable automatic compaction when deleted document ratio exceeds threshold
  //       // Default: true
  //       autoCompact: true,
  //
  //       // Compaction threshold (0.0 - 1.0)
  //       // Triggers full rebuild when deleted ratio >= this value
  //       // Default: 0.3 (30%)
  //       compactThreshold: 0.3,
  //
  //       // Sync documents with file system on server startup
  //       // Default: true
  //       syncOnStartup: true,
  //
  //       // Batch size for document processing during sync
  //       // Higher values use more memory but sync faster
  //       // Default: 50
  //       batchSize: 50
  //     }
  //   },
  //
  //   // Context Management (optional)
  //   context: {
  //     // Trigger compression when context exceeds this ratio (default: 0.7)
  //     compressionThreshold: 0.7,
  //
  //     // Target compression ratio (default: 0.1)
  //     compressionTarget: 0.1
  //   },
  //
  //   // [DEPRECATED] Self-Correcting RAG Settings — agentic 단일 모드로 통합되어 더 이상 사용되지 않음
  //   selfCorrection: {
  //     // Enable Self-Correcting RAG workflow (default: true)
  //     // When enabled, answers are first generated without RAG (fast path),
  //     // then evaluated. If answer quality is insufficient, RAG is used.
  //     enabled: true,
  //
  //     // Maximum retry count for self-correction (default: 2)
  //     // Prevents infinite loops in the workflow
  //     maxRetries: 2,
  //
  //     // Conversation history limit for context (default: 10)
  //     // Number of previous messages to include in the workflow
  //     historyLimit: 10,
  //
  //     // Evaluation confidence threshold (default: 0.7)
  //     // Below this threshold, answer may be re-evaluated
  //     evaluationThreshold: 0.7
  //   },
  //
  //   // Multi-Document Summarization Settings
  //   // Enables user requirement parsing and map-reduce summarization
  //   summarization: {
  //     // Enable enhanced summarization (default: true)
  //     // When enabled, user requirements like "1500자 이상" are parsed
  //     // and applied to summary generation
  //     enabled: true,
  //
  //     // Document count threshold for map-reduce (default: 5)
  //     // If retrieved documents exceed this, use map-reduce pattern
  //     // Below this threshold, documents are summarized directly
  //     mapReduceThreshold: 5,
  //
  //     // Maximum tokens per document group (default: 4000)
  //     // Documents are grouped by token budget for partial summarization
  //     maxTokensPerGroup: 4000,
  //
  //     // Maximum parallel map operations (default: 3)
  //     // Higher values = faster processing but more API calls
  //     maxParallelMaps: 3,
  //
  //     // Default format when not specified (default: "bullet_points")
  //     // Options: "bullet_points", "numbered_list", "table", "prose", "brief"
  //     defaultFormat: "bullet_points",
  //
  //     // Validate output length against requirements (default: true)
  //     // If output doesn't meet length constraint, retry with adjusted prompt
  //     validateLength: true,
  //
  //     // Maximum retries for length validation (default: 2)
  //     lengthValidationRetries: 2
  //   },
  //
  //   // Client-side settings (passed to browser)
  //   client: {
  //     // Request timeout in milliseconds (default: 300000 = 5 minutes)
  //     // Increase this value for slow LLM backends (e.g., local vLLM)
  //     // Recommended values:
  //     //   - 60000 (1 min): Fast cloud APIs (OpenAI, Azure)
  //     //   - 300000 (5 min): Default, balanced
  //     //   - 600000 (10 min): Slow local LLMs
  //     //   - 0: No timeout (not recommended)
  //     timeout: 300000,
  //
  //     // Keep-alive interval in milliseconds (default: 30000 = 30 seconds)
  //     // Server sends periodic heartbeat to prevent connection timeout
  //     // Set to 0 to disable keep-alive
  //     keepAliveInterval: 30000
  //   },
  //
  //   // Custom system prompt (optional)
  //   // Leave empty to use default RAG prompt
  //   systemPrompt: "",
  //
  //   // Always-on system prompt suffix (optional)
  //   // If set, this single line is ALWAYS appended to the active system prompt
  //   // (default OR custom systemPrompt above). Useful for fixed product/role context.
  //   // Example: "This is the manual for the XYZ solution."
  //   systemPromptAppend: ""
  // }
}
