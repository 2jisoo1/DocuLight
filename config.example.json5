// DocuLight Configuration File (JSON5 format)
// Copy this file to config.json5 and update with your settings
{
  // Root directory for documents (absolute path recommended)
  docsRoot: "/data/docs",

  // API authentication key for write/delete/download operations
  // IMPORTANT: Change this to a secure random string
  apiKey: "CHANGE_THIS_TO_SECURE_KEY",

  // Maximum upload file size in megabytes
  maxUploadMB: 10,

  // Port number for the server
  port: 3000,

  // UI customization
  ui: {
    // Sidebar title (default: "DocuLight")
    title: "DocuLight",

    // Icon path (default: "/images/icon.png")
    // Absolute path (starts with /): relative to public directory
    // Relative path (no / or starts with .): relative to docsRoot
    icon: "/images/icon.png",

    // Index file to auto-load on startup (optional)
    // Absolute path: /absolute/path/to/index.md
    // Relative path: relative to docsRoot (e.g., "/README.md", "/guide/index.md")
    // If not specified or file doesn't exist, shows welcome screen
    indexFile: "/README.md",

    // Custom API documentation file (optional)
    // Defaults to /public/api-doc.md
    apiIndexFile: "/public/api-doc.md",

    // Custom MCP documentation file (optional)
    // Defaults to /public/mcp-doc.md
    mcpIndexFile: "/public/mcp-doc.md"
  },

  // Files and directories to exclude (gitignore-compatible patterns)
  excludes: [
    "**/.git/",
    "**/.DS_Store",
    "**/node_modules/",
    "**/.idea/",
    "*.tmp",
    "*.log"
  ],


  // Log directory (relative or absolute path)
  logDir: "./logs",

  // Log level: 'error' | 'warn' | 'info' | 'debug'
  logLevel: "info",

  // Security settings (optional)
  security: {
    // IP whitelist patterns (optional)
    // If not specified, all IPs are allowed
    allows: [
      "127.0.0.1",           // Exact IP
      "::1",                 // IPv6 localhost
      "10.0.1.*",            // Wildcard: 10.0.1.0-255
      "10.0.100-200.*",      // Range: 10.0.100.0-255 ~ 10.0.200.0-255
      "192.168.1.0/24"       // CIDR notation
    ]
  },

  // SSL/TLS configuration (optional)
  // If enabled, server runs on HTTPS
  // If disabled or not specified, server runs on HTTP
  ssl: {
    enabled: false,
    cert: "/path/to/cert.pem",
    key: "/path/to/key.pem",
    ca: "/path/to/ca.pem"  // Optional: CA certificate
  }

  // Hot-reload options (optional)
  // hotReload.allowPortSslAutoRestart: when true, watcher will attempt an automatic restart even if port or SSL config changed.
  // Default: false (recommended) — port/SSL changes often require external coordination (load-balancer, certificates).
  // Example:
  // hotReload: {
  //   allowPortSslAutoRestart: false
  // }
}
