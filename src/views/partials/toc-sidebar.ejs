<%#
  TOC Sidebar - 목차 사이드바 템플릿

  Parameters:
    tocId     - aside 요소 ID (기본값: 'toc-sidebar')
    resizerId - 리사이저 ID (기본값: 'toc-resizer')
    closeId   - 닫기 버튼 ID (기본값: 'toc-close-btn')
    treeId    - TOC 트리 ID (기본값: 'toc-tree')
%>
<aside class="toc-sidebar" id="<%= typeof tocId !== 'undefined' ? tocId : 'toc-sidebar' %>">
  <div class="resizer" id="<%= typeof resizerId !== 'undefined' ? resizerId : 'toc-resizer' %>"></div>
  <div class="toc-header">
    <h2>Contents</h2>
    <button id="<%= typeof closeId !== 'undefined' ? closeId : 'toc-close-btn' %>" class="icon-btn" aria-label="Close table of contents">&times;</button>
  </div>
  <div class="toc-container">
    <nav class="toc-tree" id="<%= typeof treeId !== 'undefined' ? treeId : 'toc-tree' %>">
      <!-- TOC will be generated by JavaScript -->
    </nav>
  </div>
</aside>
