<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/png" href="<%= uiIcon %>">
  <style>
    :root {
      --max-width: <%= uiMaxWidth %>;
    }
  </style>
  <link rel="stylesheet" href="<%= basePath %>/css/style.css">
  <% if (typeof chatbotMode !== 'undefined' && chatbotMode) { %>
  <link rel="stylesheet" href="<%= basePath %>/css/chatbot.css">
  <% } %>
  <%- include('partials/head-libs') %>
</head>
<body>
  <!-- Mobile Overlay -->
  <div class="mobile-overlay" id="mobile-overlay"></div>

  <div class="container">
    <!-- Sidebar: File Tree -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-header">
        <div class="sidebar-title">
          <img src="<%= uiIcon %>" alt="icon" class="sidebar-icon" onerror="this.style.display='none'">
          <h1 title="<%= uiTitle %>"><%= uiTitle %></h1>
        </div>
        <button id="refresh-btn" class="icon-btn" title="Refresh">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
          </svg>
        </button>
      </div>
      <div class="tree-container" id="tree-container">
        <!-- Tree Controls: Expand All / Collapse All / Search -->
        <div class="tree-controls" id="tree-controls">
          <button id="expand-all-btn" class="tree-control-btn" title="Expand all folders" aria-label="Expand all folders">
            <img src="<%= basePath %>/images/expand.svg" alt="Expand all folders">
          </button>
          <button id="collapse-all-btn" class="tree-control-btn" title="Collapse all folders" aria-label="Collapse all folders">
            <img src="<%= basePath %>/images/collapse.svg" alt="Collapse all folders">
          </button>
          <button id="search-toggle-btn" class="tree-control-btn" title="Search documents" aria-label="Search documents">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
          </button>
        </div>

        <!-- Search UI (hidden by default) -->
        <div class="search-panel" id="search-panel" style="display: none;">
          <div class="search-input-wrapper">
            <input
              type="text"
              id="search-input"
              class="search-input"
              placeholder="Search documents..."
              autocomplete="off"
            />
            <button id="search-close-btn" class="search-close-btn" title="Close search" aria-label="Close search">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
          <div class="search-results" id="search-results">
            <!-- Search results will be displayed here -->
          </div>
        </div>

        <!-- Tree Menu (shown by default) -->
        <div class="tree-menu" id="tree-menu">
          <!-- Tree will be loaded here -->
        </div>
      </div>
    </aside>

    <!-- Resizer -->
    <div class="resizer" id="resizer"></div>

    <!-- Main Content: Markdown Viewer -->
    <main class="main-content">
      <div class="content-header">
        <button id="mobile-menu-btn" class="mobile-menu-btn" aria-label="Toggle menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <div class="breadcrumb" id="breadcrumb">
          <span>Select a document</span>
        </div>
        <!-- User Profile Button (visible when logged in) -->
        <button id="viewer-profile-btn" class="icon-btn viewer-profile-btn" title="내 정보" aria-label="내 정보" style="display:none;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </button>
        <!-- Editor Button (visible for superuser/editor) -->
        <a id="viewer-editor-btn" class="icon-btn viewer-editor-btn" title="편집" aria-label="편집" style="display:none;" href="">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
          </svg>
        </a>
        <% if (typeof chatbotMode === 'undefined' || !chatbotMode) { %>
        <!-- TOC Toggle Button (Step 12: Phase 1) -->
        <button id="toc-toggle-btn" class="toc-toggle-btn" title="Table of Contents" aria-label="Toggle table of contents">
          <img src="<%= basePath %>/images/toc-icon.svg" alt="TOC" width="16" height="16">
        </button>
        <% } %>
      </div>

      <!-- User Profile Panel (Step 17) -->
      <div id="viewer-profile-panel" class="viewer-profile-panel" style="display:none;">
        <div class="viewer-profile-header">
          <h3>내 정보</h3>
          <button id="viewer-profile-close" class="icon-btn" aria-label="닫기">&times;</button>
        </div>
        <div id="viewer-profile-content" class="viewer-profile-content"></div>
      </div>
      <div class="markdown-content" id="markdown-content">
        <% if (typeof chatbotMode !== 'undefined' && chatbotMode) { %>
        <!-- Chatbot UI (FR-CB-015: indexFile="CHATBOT" mode) -->
        <div class="chatbot-embedded" id="chatbot-embedded">
          <!-- Messages Area with wrapper for rightmost scrollbar -->
          <div class="chatbot-messages-wrapper">
            <div class="chatbot-messages" id="messagesContainer">
              <!-- Centered Welcome Message -->
              <div class="chatbot-welcome-center" id="chatbotWelcome">
                <h2>Ask anything about your documents</h2>
                <p>Type a question below to get started</p>
              </div>
            </div>
          </div>

          <!-- Workflow Indicator -->
          <div class="workflow-indicator" id="workflowIndicator" style="display: none;">
            <div class="workflow-step">
              <span class="step-icon">
                <svg class="spinner" width="16" height="16" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none" stroke-dasharray="60" stroke-dashoffset="45"/>
                </svg>
              </span>
              <span class="step-text" id="workflowStep">Processing...</span>
            </div>
            <div class="retrieval-info" id="retrievalInfo" style="display: none;">
              <span class="retrieval-icon">&#128196;</span>
              <span id="retrievalText">Found documents</span>
            </div>
          </div>

          <!-- Input Area -->
          <div class="chatbot-input">
            <form id="chatForm" class="input-form">
              <div class="chatbot-controls">
                <label class="thinking-toggle" title="Enable Thinking Mode for complex questions">
                  <input type="checkbox" id="thinkingMode" checked>
                  <span class="toggle-label">Thinking</span>
                  <span class="toggle-switch"></span>
                </label>
                <button type="button" id="newSessionBtn" class="btn-new-session" title="Start new conversation">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 5v14M5 12h14"/>
                  </svg>
                  New
                </button>
              </div>
              <div class="input-wrapper">
                <textarea
                  id="messageInput"
                  placeholder="Type your message..."
                  rows="1"
                  maxlength="4000"
                  autofocus
                ></textarea>
                <button type="submit" id="sendBtn" class="btn-send" title="Send message">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
                  </svg>
                </button>
              </div>
              <div class="input-hint">
                <span>Press <kbd>Enter</kbd> to send, <kbd>Shift+Enter</kbd> for new line</span>
              </div>
            </form>
          </div>
        </div>
        <% } else { %>
        <div class="welcome">
          <div class="welcome-header">
            <h1>Welcome to DocuLight</h1>
            <p class="welcome-subtitle">A lightweight Markdown documentation viewer and management system</p>
          </div>
        </div>
        <% } %>
      </div>
    </main>

    <!-- TOC Sidebar (Step 12: Phase 1) -->
    <aside class="toc-sidebar" id="toc-sidebar">
      <!-- Right Resizer (Step 12: Phase 1) - Inside TOC for proper positioning -->
      <div class="resizer" id="right-resizer"></div>

      <div class="toc-header">
        <h2>Contents</h2>
        <button id="toc-close-btn" class="icon-btn" aria-label="Close table of contents">×</button>
      </div>
      <div class="toc-container">
        <nav class="toc-tree" id="toc-tree">
          <!-- TOC will be generated here -->
        </nav>
      </div>
    </aside>

    <!-- TOC Mobile Overlay (Step 12: Phase 1) -->
    <div class="toc-overlay" id="toc-overlay"></div>
  </div>

  <script>window.BASE_PATH = '<%= basePath %>';</script>
  <script defer src="<%= basePath %>/js/app.js"></script>
  <% if (typeof chatbotMode !== 'undefined' && chatbotMode) { %>
  <script>
    // Chatbot mode configuration (FR-CB-015)
    window.CHATBOT_MODE = true;
    window.CHATBOT_CONFIG = <%- clientConfig || '{"timeout":300000,"keepAliveInterval":30000}' %>;
  </script>
  <script src="<%= basePath %>/js/chatbot.js"></script>
  <% } %>
</body>
</html>
