<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'DocLight' %> - Chatbot</title>
  <link rel="icon" href="<%= icon || '/images/icon.png' %>">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/chatbot.css">
  <!-- Marked.js for Markdown rendering -->
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <!-- DOMPurify for XSS protection -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.0.6/purify.min.js"></script>
  <!-- Highlight.js for code syntax highlighting -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
</head>
<body class="chatbot-page">
  <div class="chatbot-container">
    <!-- Header -->
    <header class="chatbot-header">
      <div class="header-left">
        <a href="/" class="back-link" title="Back to Documents">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
        </a>
        <h1 class="chatbot-title"><%= title || 'DocLight' %> Chatbot</h1>
      </div>
      <div class="header-right">
        <label class="thinking-toggle" title="Enable Thinking Mode for complex questions">
          <input type="checkbox" id="thinkingMode" checked>
          <span class="toggle-label">Thinking Mode</span>
          <span class="toggle-switch"></span>
        </label>
        <button id="newSessionBtn" class="btn-new-session" title="Start new conversation">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          New
        </button>
      </div>
    </header>

    <!-- Messages Area -->
    <main class="chatbot-messages" id="messagesContainer">
      <!-- Welcome message -->
      <div class="message bot-message welcome-message">
        <div class="message-avatar">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
          </svg>
        </div>
        <div class="message-content">
          <div class="message-text">
            <p>Hello! I'm your document assistant. Ask me anything about the documents in this system.</p>
            <p class="hint">Try questions like: "How do I configure the API?" or "Summarize the installation guide."</p>
          </div>
        </div>
      </div>
    </main>

    <!-- Workflow Indicator -->
    <div class="workflow-indicator" id="workflowIndicator" style="display: none;">
      <div class="workflow-step">
        <span class="step-icon">
          <svg class="spinner" width="16" height="16" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none" stroke-dasharray="60" stroke-dashoffset="45"/>
          </svg>
        </span>
        <span class="step-text" id="workflowStep">Processing...</span>
      </div>
      <div class="retrieval-info" id="retrievalInfo" style="display: none;">
        <span class="retrieval-icon">📄</span>
        <span id="retrievalText">Found documents</span>
      </div>
    </div>

    <!-- Input Area -->
    <footer class="chatbot-input">
      <form id="chatForm" class="input-form">
        <div class="input-wrapper">
          <textarea
            id="messageInput"
            placeholder="Type your message..."
            rows="1"
            maxlength="4000"
            autofocus
          ></textarea>
          <button type="submit" id="sendBtn" class="btn-send" title="Send message">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
            </svg>
          </button>
        </div>
        <div class="input-hint">
          <span>Press <kbd>Enter</kbd> to send, <kbd>Shift+Enter</kbd> for new line</span>
        </div>
      </form>
    </footer>
  </div>

  <!-- Thinking Mode Panel (shown when active) -->
  <div class="thinking-panel" id="thinkingPanel" style="display: none;">
    <div class="thinking-header">
      <span class="thinking-icon">🧠</span>
      <span>Thinking Process</span>
      <button class="thinking-close" id="closeThinking">×</button>
    </div>
    <div class="thinking-content" id="thinkingContent">
      <!-- Thinking steps will be added here -->
    </div>
  </div>

  <!-- Client configuration from server -->
  <script>
    window.CHATBOT_CONFIG = <%- clientConfig || '{"timeout":300000,"keepAliveInterval":30000}' %>;
  </script>
  <script src="/js/chatbot.js"></script>
</body>
</html>
