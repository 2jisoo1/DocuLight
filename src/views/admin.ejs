<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= config.ui?.title || 'DocLight' %> - Admin</title>
  <!-- CSS Variable for max-width (shared with normal viewer) -->
  <style>
    :root {
      --max-width: <%= config.ui?.maxWidth || '1224px' %>;
    }
  </style>
  <!-- Include normal viewer styles for markdown-content rendering -->
  <link rel="stylesheet" href="<%= basePath %>/css/style.css">
  <!-- Admin-specific styles (override as needed) -->
  <link rel="stylesheet" href="<%= basePath %>/css/admin.css">
  <%- include('partials/head-libs') %>
  <link rel="icon" href="<%= uiIcon %>">
</head>
<body>
  <!-- 인증 모달 -->
  <div id="auth-modal" class="modal">
    <div class="modal-content">
      <h2><%= config.ui?.title || 'DocLight' %> Admin</h2>
      <div class="form-group">
        <label for="api-key-input">API Key</label>
        <input type="password" id="api-key-input" placeholder="Enter API key" autocomplete="current-password">
      </div>
      <div id="auth-error" class="error-message" style="display: none;"></div>
      <div class="modal-buttons">
        <button id="auth-cancel" class="btn btn-secondary">Cancel</button>
        <button id="auth-login" class="btn btn-primary">Login</button>
      </div>
    </div>
  </div>

  <!-- 메인 레이아웃 -->
  <div id="admin-app" style="display: none;">
    <!-- 툴바 -->
    <div id="admin-toolbar">
      <div class="toolbar-left">
        <span class="app-title"><%= config.ui?.title || 'DocLight' %> Admin</span>
      </div>
      <div class="toolbar-right">
        <span id="session-name"></span>
        <button id="logout-btn" class="btn btn-small">Logout</button>
      </div>
    </div>

    <!-- 사이드바 -->
    <div id="admin-sidebar">
      <div class="sidebar-header">
        <div class="sidebar-title" role="link" tabindex="0" style="cursor:pointer">
          <img src="<%= uiIcon %>" alt="icon" class="sidebar-icon" onerror="this.style.display='none'">
          <h1 title="<%= uiTitle %>"><%= uiTitle %></h1>
        </div>
        <button id="refresh-tree" class="btn-icon" title="Refresh">&#x1F504;</button>
      </div>
      <div id="file-tree"></div>
    </div>

    <!-- 리사이저 -->
    <div id="sidebar-resizer"></div>

    <!-- 컨텐츠 -->
    <div id="admin-content">
      <!-- TOC Toggle Button (outside file-viewer to preserve during content updates) -->
      <button id="admin-toc-toggle" class="toc-toggle-btn" title="Table of Contents" aria-label="Toggle table of contents" style="display: none;">
        <img src="<%= basePath %>/images/toc-icon.svg" alt="TOC" width="16" height="16">
      </button>
      <!-- Edit Button (outside file-viewer to preserve during content updates) -->
      <button id="admin-edit-btn" class="edit-btn" title="Edit this file" aria-label="Edit this file" style="display: none;">
        Edit
      </button>
      <div id="content-placeholder">
        <p>Select a file from the tree</p>
      </div>
      <div id="file-viewer" style="display: none;"></div>

      <!-- Phase 6: Editor -->
      <div id="editor-container" style="display: none;">
        <div class="editor-toolbar">
          <div class="editor-toolbar-left">
            <span class="editor-path"></span>
            <span class="dirty-indicator"></span>
          </div>
          <div class="editor-toolbar-right">
            <button class="mode-edit btn btn-small active">Edit</button>
            <button class="mode-preview btn btn-small">Preview</button>
            <button class="editor-save btn btn-primary btn-small" disabled>Save</button>
            <button class="editor-close btn btn-secondary btn-small">Close</button>
          </div>
        </div>
        <textarea id="editor-textarea" placeholder="Enter content..."></textarea>
        <div id="editor-preview" class="markdown-content"></div>
      </div>
    </div>
  </div>

  <!-- Phase 5: Rename Modal -->
  <div id="rename-modal" class="modal">
    <div class="modal-content">
      <h2>Rename</h2>
      <input type="hidden" id="rename-path">
      <div class="form-group">
        <label>Current name</label>
        <div id="rename-current-name" class="current-name"></div>
      </div>
      <div class="form-group">
        <label for="rename-new-name">New name</label>
        <input type="text" id="rename-new-name" placeholder="Enter new name">
      </div>
      <div id="rename-error" class="error-message" style="display: none;"></div>
      <div class="modal-buttons">
        <button id="rename-cancel" class="btn btn-secondary">Cancel</button>
        <button id="rename-save" class="btn btn-primary">Rename</button>
      </div>
    </div>
  </div>

  <!-- Phase 5: Delete Confirm Modal -->
  <div id="delete-modal" class="modal">
    <div class="modal-content">
      <h2>Delete</h2>
      <input type="hidden" id="delete-paths">
      <p>Are you sure you want to delete the following items?</p>
      <ul id="delete-list" class="delete-list"></ul>
      <div id="delete-error" class="error-message" style="display: none;"></div>
      <div class="modal-buttons">
        <button id="delete-cancel" class="btn btn-secondary">Cancel</button>
        <button id="delete-confirm" class="btn btn-danger">Delete</button>
      </div>
    </div>
  </div>

  <!-- Phase 5: Create Modal -->
  <div id="create-modal" class="modal">
    <div class="modal-content">
      <h2 id="create-title">New File</h2>
      <input type="hidden" id="create-parent-path">
      <input type="hidden" id="create-type">
      <div class="form-group">
        <label for="create-name">Name</label>
        <input type="text" id="create-name" placeholder="Enter name">
      </div>
      <div id="create-error" class="error-message" style="display: none;"></div>
      <div class="modal-buttons">
        <button id="create-cancel" class="btn btn-secondary">Cancel</button>
        <button id="create-save" class="btn btn-primary">Create</button>
      </div>
    </div>
  </div>

  <!-- Phase 6: Unsaved Changes Modal -->
  <div id="unsaved-modal" class="modal">
    <div class="modal-content">
      <h2>Unsaved Changes</h2>
      <p>You have unsaved changes in <span class="file-path"></span></p>
      <p class="text-secondary">Do you want to save before leaving?</p>
      <div class="modal-buttons">
        <button class="btn btn-secondary btn-cancel">Cancel</button>
        <button class="btn btn-danger btn-discard">Discard</button>
        <button class="btn btn-primary btn-save">Save</button>
      </div>
    </div>
  </div>

  <!-- Phase 6: Conflict Modal -->
  <div id="conflict-modal" class="modal">
    <div class="modal-content">
      <h2>File Conflict</h2>
      <p>This file was modified by another user.</p>
      <p class="text-secondary">Server version: <span class="server-time"></span></p>
      <div class="modal-buttons">
        <button class="btn btn-secondary btn-reload">Reload</button>
        <button class="btn btn-danger btn-overwrite">Overwrite</button>
      </div>
    </div>
  </div>

  <!-- TOC Sidebar (Admin) -->
  <%- include('partials/toc-sidebar', {
    tocId: 'admin-toc-sidebar',
    resizerId: 'admin-toc-resizer',
    closeId: 'admin-toc-close',
    treeId: 'admin-toc-tree'
  }) %>

  <!-- TOC Overlay (Mobile) -->
  <div class="toc-overlay" id="admin-toc-overlay"></div>

  <!-- Admin Script -->
  <script>window.BASE_PATH = '<%= basePath %>';</script>
  <script src="<%= basePath %>/js/admin.js"></script>
</body>
</html>
