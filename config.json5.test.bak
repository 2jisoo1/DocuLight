// DocLight Test Configuration
{
  docsRoot: "./test-source",
  apiKey: "test-key-12345",
  maxUploadMB: 10,
  port: 3000,
  ui: {
    title: "DOC LIGHT"
    // icon: "icon.png"  // Optional: defaults to /images/icon.png if not specified
  },
  excludes: [
    "**/.git/",
    "**/.DS_Store",
    "**/node_modules/"
  ],
  logDir: "./logs",
  logLevel: "info",

  // SSL/TLS configuration
  ssl: {
    enabled: false,
    cert: "/tmp/doclight-cert.pem",
    key: "/tmp/doclight-key.pem"
  }
}
